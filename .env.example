# =============================================================================
# docflow-agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#
# LOCAL DEV  → uses localhost postgres + redis (see docker-compose.yml)
# PRODUCTION → uses Neon DB (postgres) + Upstash (redis)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (the server key is used for all requests)
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq                        # groq | ollama | openai
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here      # Your Groq API key (free at console.groq.com)
GROQ_BASE_URL=                           # Only for scripts/load_test.py against scripts/fake_groq.py

# -----------------------------------------------------------------------------
# Database
# LOCAL DEV  → postgresql://docflow:docflow@localhost:5432/docflow
# PRODUCTION → postgresql://user:pass@ep-xxx.neon.tech/docflow?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://docflow:docflow@localhost:5432/docflow

# -----------------------------------------------------------------------------
# Redis (ARQ queue backend)
# LOCAL DEV  → redis://localhost:6379
# PRODUCTION → redis://default:PASSWORD@global-xxx.upstash.io:PORT
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Rate Limiting (protects your Groq API budget)
# Session = per browser (localStorage UUID), IP = backstop, Global = daily cap
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_SESSION=10                 # Max extractions per session per day
RATE_LIMIT_PER_IP=30                      # Max extractions per IP per day
RATE_LIMIT_GLOBAL=500                     # Max total extractions per day (budget ceiling)

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.75                # Below this → flagged for HITL review
MAX_UPLOAD_SIZE_MB=10
ENVIRONMENT=development                  # development | production

# -----------------------------------------------------------------------------
# CORS
# LOCAL DEV  → http://localhost:3000
# PRODUCTION → https://your-app.vercel.app (comma-separate multiple origins)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Webhook
# -----------------------------------------------------------------------------
# Off by default. When true, WEBHOOK_SECRET must be set (used to sign payloads).
WEBHOOKS_ENABLED=false
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Token budget (ADR 006) — Groq free tier defaults. Change these when you move
# to a paid tier; the code does not change, only these numbers.
# -----------------------------------------------------------------------------
LLM_TPM=8000                              # Tokens per minute
LLM_RPM=30                                # Requests per minute
LLM_TPD=200000                            # Tokens per day
LLM_RPD=1000                              # Requests per day
LLM_MAX_COMPLETION_TOKENS=1024            # Reply budget reserved on every call
SESSION_INFLIGHT_CAP=2                    # Max documents one session can have in flight

# -----------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* are baked into the client bundle at build time)
# Set these in the Vercel/deployment env, NOT here for prod secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/your-handle

# =============================================================================
# PRODUCTION OVERRIDES (uncomment and fill when deploying to Render)
# =============================================================================
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/docflow?sslmode=require
# REDIS_URL=redis://default:YOUR_UPSTASH_PASSWORD@global-YOUR-ENDPOINT.upstash.io:PORT
# ENVIRONMENT=production
